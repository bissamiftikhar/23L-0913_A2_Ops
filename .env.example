# DagsHub & MLflow Tracking Configuration
MLFLOW_TRACKING_URI=https://dagshub.com/bissamiftikhar/23L-0913_A2_Ops.mlflow
MLFLOW_TRACKING_USERNAME=your_dagshub_username
MLFLOW_TRACKING_PASSWORD=your_dagshub_token_here
DAGSHUB_USER_TOKEN=your_dagshub_token_here

# VisionGuard Web App & Model Configuration
MODEL_PATH=models/champion_model.keras
DECISION_THRESHOLD=0.50
MODEL_VERSION=VisionGuard-MobileNetV2-v2@champion
MAX_CONTENT_LENGTH_MB=10
FLASK_DEBUG=0
PORT=5001

# Database Configuration (PostgreSQL in Compose / SQLite fallback locally)
POSTGRES_USER=visionguard
POSTGRES_PASSWORD=change_me_in_production
POSTGRES_DB=visionguard_db
DATABASE_URL=postgresql://visionguard:change_me_in_production@db:5432/visionguard_db

# Cloud Inference API Configuration (Tasks 7 & 8)
CLOUD_API_URL=https://your-cloud-api-url.onrender.com/api/predict
API_SECRET_KEY=change_me_api_secret_key

